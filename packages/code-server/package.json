{
  "name": "@sylphx/code-server",
  "version": "1.0.1",
  "description": "Sylphx Code Server - Lens server for AI streaming",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sylphx-code-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./src/*": {
      "import": "./src/*",
      "types": "./src/*"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunup && node fix-duplicate-exports.js",
    "dev": "bun src/cli.ts",
    "start": "bun dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@sylphx/code-api": "workspace:*",
    "@sylphx/code-core": "workspace:*",
    "@sylphx/lens-core": "^4.1.0",
    "@sylphx/lens-server": "^4.1.6",
    "@sylphx/reify": "^0.1.3",
    "mime-types": "^2.1.35",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.0.6",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "keywords": [
    "trpc",
    "server",
    "sse",
    "streaming",
    "api"
  ],
  "author": "SylphxAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SylphxAI/code.git",
    "directory": "packages/code-server"
  }
}
