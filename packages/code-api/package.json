{
  "name": "@sylphx/code-api",
  "version": "1.0.1",
  "description": "Sylphx Code API - Lens-based type-safe API definitions",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "echo 'Skipping build - runtime-only package'",
    "type-check": "tsc --noEmit",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@sylphx/code-core": "workspace:*",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "keywords": [
    "api",
    "lens",
    "type-safe"
  ],
  "author": "SylphxAI",
  "license": "MIT"
}
