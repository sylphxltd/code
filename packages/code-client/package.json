{
  "name": "@sylphx/code-client",
  "version": "1.0.1",
  "description": "Sylphx Code Client - Framework-agnostic signals and utilities",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./src/*.js": {
      "import": "./src/*.tsx",
      "types": "./src/*.tsx"
    },
    "./src/*": {
      "import": "./src/*",
      "types": "./src/*"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'Skip build - used as source package'",
    "dev": "bun --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@sylphx/lens-client": "^3.1.7",
    "@sylphx/lens-react": "^2.6.7"
  },
  "devDependencies": {
    "@sylphx/code-server": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.0.0",
    "bun-types": "^1.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.6",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "keywords": [
    "react",
    "hooks",
    "components",
    "trpc",
    "client"
  ],
  "author": "SylphxAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SylphxAI/code.git",
    "directory": "packages/code-client"
  }
}
